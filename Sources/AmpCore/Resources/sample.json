        "Freq": 0.04,
        "Depth": 0.2,
        "Pre": 0.5,
        "Feedback": 0.13,
        "@wetDry": 0.5,
        "@enabled": false
      }
    },
    "delay": {
      "model": "TapeEcho",
      "parameters": {
        "Time": 0.391,
        "Feedback": 0.63,
        "Bass": 0.5,
        "Treble": 0,
        "@wetDry": 0.5,
        "@enabled": false
      }
    },
    "reverb": {
