{
  "schemaVersion": 1,
  "target": "yamaha.thr-ii",
  "name": "Warm neck breakup",
  "description": "Warm edge of breakup for neck single coils, subtle spring. Set physical guitar output low by hand.",
  "tags": [
    "warm",
    "single-coil",
    "breakup"
  ],
  "suggestions": "Neck pickup, guitar volume 7\u201310; pick softly for clean. Set bedroom listening volume on the amp.",
  "firmwareConstraints": [],
  "tone": {
    "amp": {
      "model": "THR10C_Deluxe",
      "parameters": {
        "Drive": 0.38,
        "Master": 0.5,
        "Bass": 0.42,
        "Mid": 0.6,
        "Treble": 0.44
      }
    },
    "modulation": {
      "model": "StereoSquareChorus",
